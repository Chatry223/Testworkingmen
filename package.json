{
  "name": "volveedge",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:migrate && wrangler deploy"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_TOKEN": {
        "description": "Required: a long random admin secret (at least 32 characters). Keep it private."
      }
    }
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
